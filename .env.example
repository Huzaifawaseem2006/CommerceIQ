# Setup/admin connection for running scripts/init_db.sql and scripts/seed_data.py.
# Use a local MySQL account with permission to create schema/tables and insert seed data.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=commerceiq
MYSQL_USER=root
MYSQL_PASSWORD=replace_with_local_setup_password

# Runtime read-only account for the future CLI/query_database implementation.
COMMERCEIQ_DB_HOST=localhost
COMMERCEIQ_DB_PORT=3306
COMMERCEIQ_DB_NAME=commerceiq
COMMERCEIQ_DB_USER=commerceiq_readonly
COMMERCEIQ_DB_PASSWORD=replace_with_readonly_password

# Future Claude integration. Not used in milestone 1.
ANTHROPIC_API_KEY=replace_with_anthropic_api_key
ANTHROPIC_MODEL=claude-sonnet-4-5
